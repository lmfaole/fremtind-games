{
    "name": "fremtind-games",
    "private": true,
    "packageManager": "pnpm@12.18.0",
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "copy-fonts": "node scripts/copy-fonts.mjs",
        "predev": "pnpm copy-fonts",
        "dev": "next dev",
        "prebuild": "pnpm copy-fonts",
        "build": "next build",
        "start": "next start",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "node --experimental-strip-types scripts/check-questions.ts",
        "verify": "pnpm typecheck && pnpm format:check && pnpm check"
    },
    "dependencies": {
        "@fremtind/jokul": "next",
        "next": "^16.4.6",
        "react": "^19.1.0",
        "react-dom": "^19.1.0"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@types/react": "^19.1.0",
        "@types/react-dom": "^19.1.0",
        "prettier": "^3.10.1",
        "sass": "^1.85.0",
        "typescript": "^7.0.2"
    }
}
