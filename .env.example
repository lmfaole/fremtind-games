# Adresse til backenden som samler anonyme svar og leverer statistikk.
# Er den ikke satt, er all statistikk slått av: ingen nettverkskall og ingenting vises.
# Verdien inlines ved bygg (NEXT_PUBLIC_), så den må settes før `pnpm build`.
NEXT_PUBLIC_API_URL=http://localhost:8787

# PostHog (atferdsanalyse og A/B-testing). Offentlig, skrivebeskyttet prosjekttoken (phc_…).
# Er den ikke satt, lastes ikke PostHog i det hele tatt. Prosjektet ligger i EU-regionen.
NEXT_PUBLIC_POSTHOG_TOKEN=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Web Push. Offentlig VAPID-nøkkel (generer med worker/scripts/generate-vapid-keys.mjs).
# Er den ikke satt, eller NEXT_PUBLIC_API_URL mangler, skjules varselknappen.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
